package PageObjectModel;



import java.util.Arrays;
import java.util.List;

import org.openqa.selenium.WebDriver;
import org.testng.Assert;
import org.testng.annotations.Test;
import org.testng.asserts.Assertion;

import BaseTest.Base;

public class LoginTest extends Base{
	
	@Test
    public void testInvalidLoginShowErrorMsg() throws InterruptedException {
        LoginPage loginPage = new LoginPage(driver);
        
        loginPage.enterUserId("sumit");
        
        loginPage.enterUserPassword("password");
        loginPage.ClickOnSubmitButton();
        Thread.sleep(5000);
        
        
        
        String actualErrorMsg = loginPage.InvalidMsg();
        List<String> expectedErrors = Arrays.asList(
            "Invalid Credentials",
            "Error: To proceed to the login page please allow 'Notifications' and then click 'Reload' to continue."
        );
        Assert.assertTrue(expectedErrors.contains(actualErrorMsg),
            "Unexpected error message: " + actualErrorMsg);
    }
